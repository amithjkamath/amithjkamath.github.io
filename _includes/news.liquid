{% comment %}
  Renders the news collection. Pass lang="de" / lang="sa" to pick up the
  `content_de` / `content_sa` overrides in each item's front matter; items
  without a translation fall back to the English body.
{% endcomment %}

{% assign lang = include.lang | default: 'en' %}

<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and page.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          {% comment %} Liquid only knows English month names, so translated pages get numeric dates. {% endcomment %}
          {% if lang == 'en' %}
            {% assign item_date = item.date | date: '%b %d, %Y' %}
          {% else %}
            {% assign item_date = item.date | date: '%d.%m.%Y' %}
          {% endif %}

          {% if lang == 'de' and item.content_de %}
            {% assign item_body = item.content_de | markdownify %}
          {% elsif lang == 'sa' and item.content_sa %}
            {% assign item_body = item.content_sa | markdownify %}
          {% else %}
            {% assign item_body = item.content %}
          {% endif %}

          {% if lang == 'de' and item.title_de %}
            {% assign item_title = item.title_de %}
          {% elsif lang == 'sa' and item.title_sa %}
            {% assign item_title = item.title_sa %}
          {% else %}
            {% assign item_title = item.title %}
          {% endif %}

          <tr>
            <th scope="row" style="width: 20%">{{ item_date }}</th>
            <td>
              {% if item.inline %}
                {{ item_body | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item_title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
